# Planbox 本地环境配置模板。复制为 .env 后填写；.env 已被 .gitignore 排除，不得提交。

# --- LLM 抽取（OpenAI 兼容协议）---
# StepFun 示例（把 <你的 Key> 换成 StepFun 控制台获取的 API Key，型号用你实际开通的）：
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<你的 Key>
#   OPENAI_BASE_URL=https://api.stepfun.com/v1
#   OPENAI_MODEL=step-1-8k
# 不填时默认 fake：仅做规则抽取与接口回归，不代表模型质量。
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.stepfun.com/v1
OPENAI_MODEL=step-1-8k

# --- 服务 ---
# PORT=8000
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 抓取超时（秒）---
# WECHAT_FETCH_TIMEOUT=10
# XIAOHONGSHU_FETCH_TIMEOUT=10

# Planbox 本地环境配置模板。复制为 .env 后填写；.env 已被 .gitignore 排除，不得提交。

# --- LLM 抽取（OpenAI 兼容协议）---
# StepFun 示例（2026-11-05 实测可用）：Step Plan 订阅必须走 step_plan 专用端点，
# 标准端点 /v1 只消耗按量余额（会报 402）。step-1-8k 等旧型号不在 Step Plan 支持列表。
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<你的 Key>
#   OPENAI_BASE_URL=https://api.stepfun.com/step_plan/v1
#   OPENAI_MODEL=step-5-preview
# 不填时默认 fake：仅做规则抽取与接口回归，不代表模型质量。
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.stepfun.com/step_plan/v1
OPENAI_MODEL=step-5-preview

# --- 服务 ---
# PORT=8000
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 抓取超时（秒）---
# WECHAT_FETCH_TIMEOUT=10
# XIAOHONGSHU_FETCH_TIMEOUT=10

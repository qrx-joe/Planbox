.page { padding: 40rpx 32rpx 64rpx; padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.eyebrow { color: #a5b4fc; font-size: 24rpx; letter-spacing: 2rpx; }
.heading { font-size: 42rpx; font-weight: 600; margin: 12rpx 0; }
.description, .counter { color: #cbd5e1; font-size: 26rpx; }
.card { background: #1e293b; border: 1rpx solid #475569; border-radius: 24rpx; padding: 28rpx; margin: 28rpx 0; }
label, .label { display: block; font-weight: 600; margin-bottom: 12rpx; }
input, textarea { box-sizing: border-box; width: 100%; background: #0f172a; color: #f8fafc; border: 1rpx solid #64748b; border-radius: 12rpx; padding: 20rpx; }
input { height: 96rpx; margin-bottom: 24rpx; }
textarea { height: 380rpx; margin-top: 20rpx; }
.counter { text-align: right; margin-top: 12rpx; }
.summary { color: #cbd5e1; white-space: pre-wrap; overflow-wrap: break-word; }
.notice { background: #1e293b; border-left: 6rpx solid #818cf8; padding: 24rpx; border-radius: 8rpx; }
.receipt { color: #cbd5e1; font-size: 24rpx; word-break: break-all; margin: 20rpx 0; }
.receipt text { display: block; }
.error { background: #451a24; color: #fecdd3; padding: 24rpx; margin: 20rpx 0; border-radius: 12rpx; }
.primary { background: #6366f1; color: #fff; margin: 28rpx 0 20rpx; }
.secondary { background: #334155; color: #f8fafc; margin-top: 20rpx; }
button[disabled] { background: #334155; color: #cbd5e1; }
